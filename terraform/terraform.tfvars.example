aws_region       = "ap-south-1"
project_name     = "enterprise-access-management-portal"
instance_type    = "t3.micro"
key_name         = "accessportal-key"
public_key_path  = "~/.ssh/accessportal-key.pub"

# Replace with your public IP in CIDR format.
# Example: "49.37.10.25/32"
allowed_ssh_cidr = "YOUR_PUBLIC_IP/32"

# Replace with your GitHub repository HTTPS URL after pushing code.
github_repo_url = "https://github.com/YOUR_USERNAME/enterprise-access-management-portal.git"
