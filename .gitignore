cat > .gitignore <<'EOF'
# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.iml

# Logs
*.log
logs/

# Environment files
.env
.env.*
!.env.example

# Java / Maven
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar

# Node / React
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Docker / local runtime
*.pid

# Test coverage
coverage/
frontend/coverage/

# Terraform
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.*
terraform/terraform.tfvars
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/crash.log
terraform/crash.*.log
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json
terraform/.terraformrc
terraform/terraform.rc

# SSH keys / certificates
*.pem
*.key
*.pub
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Temporary files
tmp/
temp/
EOF